{
  // Used only by vitest: same worker, roomy rate limit so tests do not throttle
  // each other (Miniflare keys the limiter on the connection, not on a header).
  "name": "gratideo-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gratideo-db-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 1000, "period": 60 }
    }
  ]
}

